---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Pricing | Crontinel"
  description="Crontinel's Free plan is available now. Paid plans are being prepared."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Crontinel',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web',
    url: 'https://crontinel.com',
    offers: { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD', url: 'https://app.crontinel.com/register' },
  })} />

  <Nav />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-20" id="main-content">
    <div class="max-w-2xl mb-12">
      <p class="text-sm text-green-400 mb-3">Pricing</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4">Start free. Paid plans are being prepared.</h1>
      <p class="text-gray-400">We are checking the paid billing flow and usage limits before opening paid signups. This page will carry the final terms when they are ready.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <section class="bg-gray-900 border border-gray-800 rounded-xl p-7">
        <h2 class="text-xl font-semibold text-white mb-2">Free</h2>
        <p class="text-3xl font-bold text-white mb-5">$0</p>
        <ul class="text-sm text-gray-300 space-y-2 mb-7">
          <li>One connected app</li>
          <li>Five monitors per app</li>
          <li>Seven days of cron run and monitor event history</li>
        </ul>
        <a href="https://app.crontinel.com/register" class="inline-block bg-green-500 hover:bg-green-400 text-black font-semibold px-5 py-2.5 rounded-lg transition-colors">Get started free</a>
      </section>

      <section class="bg-gray-900 border border-gray-800 rounded-xl p-7">
        <h2 class="text-xl font-semibold text-white mb-2">Paid plans</h2>
        <p class="text-gray-400 mb-5">Starter, Pro, and Max are planned. Their checkout flow and final usage terms are still under review.</p>
        <p class="text-sm text-gray-400">Any runtime can post an <a href="https://docs.crontinel.com/check-in/recipes/" class="text-green-400 underline">HTTP check-in recipe</a>. Laravel teams can also install the <a href="https://docs.crontinel.com/sdks/laravel/" class="text-green-400 underline">Composer package</a> for schedule, queue, and Horizon.</p>
      </section>
    </div>
  </main>

  <Footer />
</Base>
