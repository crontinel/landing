---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import HttpReceiptCta from "../components/HttpReceiptCta.astro";
---

<Base
    title="Crontinel Agent: Allowlisted Commands"
    description="Optional Laravel agent for allowlisted cloud-triggered commands. Outcome monitoring uses the HTTP receipt for every runtime."
>
    <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://crontinel.com" },
        { "@type": "ListItem", "position": 2, "name": "Agent", "item": "https://crontinel.com/agent/" }
      ]
    }
    </script>
    <Nav />
    <main class="max-w-3xl mx-auto px-4 py-16" id="main-content">
        <h1 class="text-3xl font-bold text-white mb-4">Optional command agent</h1>
        <p class="text-slate-400 mb-4">Outcome monitoring does not require this agent. Any runtime posts an HTTP receipt when the job finishes. See the <a href="https://docs.crontinel.com/check-in/recipes/" class="text-green-400 underline">check-in recipes</a>.</p>
        <p class="text-slate-400 mb-8">The agent below is only for allowlisted commands triggered from the cloud. It refuses every command until you configure an allowlist.</p>

        <section class="mb-12">
            <h2 class="text-xl font-semibold text-white mb-3">Laravel agent</h2>
            <div class="bg-slate-900 rounded-xl p-5 mb-4">
                <pre class="text-sm text-green-400 overflow-x-auto"><code># 1. Install the package
composer require crontinel/laravel

# 2. Run the install command
php artisan crontinel:install

# 3. Add to .env
CRONTINEL_API_KEY=YOUR_API_KEY_HERE
CRONTINEL_API_URL=https://app.crontinel.com

# 4. Start the agent
php artisan crontinel:agent</code></pre>
            </div>
            <p class="text-sm text-slate-500">Generate systemd or Supervisor config: <code class="text-green-400">php artisan crontinel:agent --systemd</code>. Allowlisting docs: <a href="https://docs.crontinel.com/agent/guide/#command-allowlisting" class="text-green-400 underline">Command Allowlisting</a>.</p>
        </section>

        <section class="mb-12">
            <h2 class="text-xl font-semibold text-white mb-3">Other language agents</h2>
            <p class="text-slate-400 mb-4">Node and Python agent packages are not a supported path for outcome receipts. Prefer the HTTP check-in for job monitoring. Do not treat npm or pip agent installs as parity with the Laravel package.</p>
        </section>

        <HttpReceiptCta heading="Monitor job outcomes without the agent" class="mb-12" />
    </main>
    <Footer />
</Base>
