---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Lifetime deal closed | Crontinel"
  description="The earlier Crontinel lifetime offer is closed."
>
  <meta name="robots" content="noindex,follow" slot="head" />
  <Nav />

  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-24" id="main-content">
    <p class="text-sm text-green-400 mb-4">Offer closed</p>
    <h1 class="text-3xl sm:text-4xl font-bold text-white mb-5">The lifetime deal is closed.</h1>
    <p class="text-gray-400 mb-8">The previous Solo, Pro, and Agency one-time offers are no longer available. No new lifetime codes are being sold.</p>
    <a href="/pricing/" class="inline-block border border-gray-700 hover:border-gray-500 text-gray-200 font-medium px-5 py-2.5 rounded-lg transition-colors">See current availability</a>
  </main>

  <Footer />
</Base>
