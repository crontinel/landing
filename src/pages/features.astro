---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import RuntimeStrip from '../components/RuntimeStrip.astro';
import HttpReceiptCta from '../components/HttpReceiptCta.astro';
---

<Base
  title="Outcome monitoring for background jobs - Features | Crontinel"
  description="Monitor job outcomes from curl, Node, Python, Sidekiq, and GitHub Actions. Optional Laravel package for schedule, queues, and Horizon. Slack, email, and webhook alerts."
>
<script type="application/ld+json" slot="head">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Crontinel",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Web, Linux",
  "description": "Outcome monitor for background jobs. HTTP check-in from curl, Node, Python, Sidekiq, and GitHub Actions. Optional Laravel package for schedule attach, queue depth, and Horizon freshness.",
  "url": "https://crontinel.com/features/",
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": "0",
    "highPrice": "49",
    "priceCurrency": "USD"
  },
  "featureList": [
    "HTTP outcome receipt for curl, Node, Python, Sidekiq, and GitHub Actions",
    "Separate process exit from business result (processed_records)",
    "Optional Laravel package for schedule, queue depth, and Horizon",
    "Slack, email, PagerDuty, Discord, Microsoft Teams, Telegram, and webhook alert channels",
    "Multi-app hosted dashboard",
    "REST API for programmatic access",
    "MCP evidence for coding assistants"
  ],
  "provider": {
    "@type": "Organization",
    "@id": "https://crontinel.com/#organization"
  }
}
</script>

<script type="application/ld+json" slot="head">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://crontinel.com" },
    { "@type": "ListItem", "position": 2, "name": "Features", "item": "https://crontinel.com/features/" }
  ]
}
</script>

  <Nav />

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-16" id="main-content">
    <div class="text-center mb-16">
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        Outcome monitoring for the jobs you already run
      </h1>
      <p class="text-gray-400 max-w-xl mx-auto mb-8">
        Not just "did it ping back." A finished process can still do no work. Post one HTTP receipt from five common runtimes. Laravel Horizon depth is optional on top.
      </p>
      <RuntimeStrip />
    </div>

    <div class="space-y-20">

      <!-- HTTP outcome receipt -->
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <div class="inline-block text-xs font-semibold text-green-400 bg-green-500/10 border border-green-500/20 px-2.5 py-0.5 rounded-full mb-4">Works in every runtime</div>
          <h2 class="text-2xl font-bold text-white mb-4">One HTTP receipt. Exit and outcome stay separate.</h2>
          <p class="text-gray-400 mb-4">
            Post to <code class="text-green-400 bg-gray-800 px-1 rounded text-xs">/api/v1/ingest/cron</code> when the job finishes. Include <code class="text-green-400 bg-gray-800 px-1 rounded text-xs">processed_records</code> when the business result can be a count. Exit 0 with zero records can still open an incident.
          </p>
          <ul class="space-y-2 text-sm text-gray-400">
            <li class="flex gap-2"><span class="text-green-400">✓</span> curl / system cron</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Node (fetch / node-cron / Bull)</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Python (script / Celery)</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Sidekiq / Ruby</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> GitHub Actions</li>
          </ul>
        </div>
        <div class="bg-gray-900 rounded-xl border border-gray-800 p-5 font-mono text-xs">
          <div class="text-gray-400 mb-3">Outcome receipt</div>
          <div class="space-y-2">
            <div class="flex justify-between"><span class="text-gray-400">status</span><span class="text-green-400">completed</span></div>
            <div class="flex justify-between"><span class="text-gray-400">exit_code</span><span class="text-green-400">0</span></div>
            <div class="flex justify-between"><span class="text-gray-400">processed_records</span><span class="text-red-400">0 ← alert</span></div>
            <div class="flex justify-between"><span class="text-gray-400">runtime</span><span class="text-gray-300">any of five</span></div>
          </div>
        </div>
      </div>

      <!-- Horizon monitoring (Laravel deep) -->
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <div class="inline-block text-xs font-semibold text-green-400 bg-green-500/10 border border-green-500/20 px-2.5 py-0.5 rounded-full mb-4">Laravel deep package</div>
          <h2 class="text-2xl font-bold text-white mb-4">Horizon internals when you run Laravel</h2>
          <p class="text-gray-400 mb-4">
            The Composer package can read Horizon's Redis keys and attach schedule evidence. Not required for outcome monitoring on other runtimes.
          </p>
          <ul class="space-y-2 text-sm text-gray-400">
            <li class="flex gap-2"><span class="text-green-400">✓</span> Supervisor status per supervisor (not just "Horizon is running")</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Paused detection</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Failed jobs per minute with configurable threshold</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Alerts when any supervisor goes down</li>
          </ul>
        </div>
        <div class="bg-gray-900 rounded-xl border border-gray-800 p-5 font-mono text-xs">
          <div class="text-gray-400 mb-3">Horizon status snapshot</div>
          <div class="space-y-2">
            <div class="flex justify-between"><span class="text-gray-400">status</span><span class="text-green-400">running</span></div>
            <div class="flex justify-between"><span class="text-gray-400">supervisor-1</span><span class="text-green-400">running (3 workers)</span></div>
            <div class="flex justify-between"><span class="text-gray-400">supervisor-2</span><span class="text-red-400">down ← alert</span></div>
            <div class="flex justify-between"><span class="text-gray-400">failed / min</span><span class="text-yellow-400">4.2 (threshold: 5)</span></div>
            <div class="flex justify-between"><span class="text-gray-400">paused</span><span class="text-green-400">no</span></div>
          </div>
        </div>
      </div>

      <!-- Queue monitoring -->
      <div class="grid sm:grid-cols-2 gap-10 items-center">
        <div class="bg-gray-900 rounded-xl border border-gray-800 p-5 font-mono text-xs order-2 sm:order-1">
          <div class="text-gray-400 mb-3">Queue depths</div>
          <table class="w-full">
            <thead><tr class="text-gray-600"><th class="text-left">Queue</th><th class="text-right">Depth</th><th class="text-right">Failed</th><th class="text-right">Health</th></tr></thead>
            <tbody class="divide-y divide-gray-800">
              <tr><td class="py-1.5 text-gray-300">default</td><td class="text-right text-gray-300">5</td><td class="text-right text-gray-300">0</td><td class="text-right text-green-400">ok</td></tr>
              <tr class="bg-red-950/20"><td class="py-1.5 text-gray-300">emails</td><td class="text-right text-red-400">1,204</td><td class="text-right text-red-400">3</td><td class="text-right text-red-400">alert</td></tr>
              <tr><td class="py-1.5 text-gray-300">notifications</td><td class="text-right text-gray-300">12</td><td class="text-right text-gray-300">0</td><td class="text-right text-green-400">ok</td></tr>
            </tbody>
          </table>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-white mb-4">Queue depth, before it becomes a customer complaint</h2>
          <p class="text-gray-400 mb-4">
            Set per-queue thresholds for depth, failed count, and oldest job age.
            Get alerted before the backlog becomes a problem.
          </p>
          <ul class="space-y-2 text-sm text-gray-400">
            <li class="flex gap-2"><span class="text-green-400">✓</span> Depth threshold per queue</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Failed count threshold</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Oldest job age (wait time) alert</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Works with Redis and database queue drivers</li>
          </ul>
        </div>
      </div>

      <!-- Cron tracking -->
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <h2 class="text-2xl font-bold text-white mb-4">Run history: exit code and business result</h2>
          <p class="text-gray-400 mb-4">
            Every receipt records status, exit code, and outcome metrics. On Laravel, the package can also attach scheduler events automatically. Everywhere else, wrap the job and POST the same JSON.
          </p>
          <ul class="space-y-2 text-sm text-gray-400">
            <li class="flex gap-2"><span class="text-green-400">✓</span> Exit code per run</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Outcome column separate from process status</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> "Late" detection when named jobs miss the schedule</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Historical chart per command</li>
          </ul>
        </div>
        <div class="bg-gray-900 rounded-xl border border-gray-800 p-5 font-mono text-xs">
          <div class="text-gray-400 mb-3">Scheduled commands</div>
          <table class="w-full">
            <thead><tr class="text-gray-600"><th class="text-left">Command</th><th class="text-right">Last run</th><th class="text-right">Status</th></tr></thead>
            <tbody class="divide-y divide-gray-800">
              <tr><td class="py-1.5 text-gray-300">inspire</td><td class="text-right text-gray-400">6h ago</td><td class="text-right text-green-400">ok</td></tr>
              <tr><td class="py-1.5 text-gray-300">send-invoices</td><td class="text-right text-gray-400">5d ago</td><td class="text-right text-green-400">ok</td></tr>
              <tr class="bg-yellow-950/20"><td class="py-1.5 text-gray-300">cleanup-old-logs</td><td class="text-right text-gray-400">23h ago</td><td class="text-right text-yellow-400">⚠ late</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Agent -->
      <div class="bg-gray-900/40 border border-gray-800 rounded-xl p-8">
        <h2 class="text-2xl font-bold text-white mb-2 text-center">Crontinel Agent: run commands from the dashboard</h2>
        <p class="text-gray-400 text-center mb-6">
          A lightweight daemon (Laravel, Node, or Python) that connects to your app and executes commands you schedule from the cloud. Refuses to run anything until you explicitly allowlist it; nothing runs by default.
        </p>
        <div class="text-center">
          <a href="/agent/" class="text-sm font-medium text-green-400 hover:text-green-300 underline">Set up the agent →</a>
        </div>
      </div>

      <!-- Alerts -->
      <div class="bg-gray-900/40 border border-gray-800 rounded-xl p-8">
        <h2 class="text-2xl font-bold text-white mb-2 text-center">Alerts that go where you work</h2>
        <p class="text-gray-400 text-center mb-8">Fires when something breaks. Resolves automatically when it recovers. No noise.</p>
        <div class="grid sm:grid-cols-4 gap-4">
          {[
            { name: 'Slack', desc: 'Webhook or app integration' },
            { name: 'Email', desc: 'Single or multiple recipients' },
            { name: 'PagerDuty', desc: 'Full incident lifecycle' },
            { name: 'Webhook', desc: 'Any endpoint you choose' },
            { name: 'Discord', desc: 'Post to a server channel' },
            { name: 'Microsoft Teams', desc: 'Post to a team channel' },
            { name: 'Telegram', desc: 'Bot API, direct to a chat' },
          ].map((ch) => (
            <div class="bg-gray-900 rounded-lg p-4 border border-gray-800 text-center">
              <div class="font-medium text-white mb-1">{ch.name}</div>
              <div class="text-xs text-gray-400">{ch.desc}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Integrations -->
      <div class="bg-gray-900/40 border border-gray-800 rounded-xl p-8">
        <h2 class="text-2xl font-bold text-white mb-2 text-center">Five runtimes. One ingest API. MCP for assistants.</h2>
        <p class="text-gray-400 text-center mb-8">HTTP receipt for every stack. Laravel package when you want schedule and Horizon depth.</p>
        <div class="int-pills">
          <span class="int-pill"><span class="dot ok"></span> curl / cron</span>
          <span class="int-pill"><span class="dot ok"></span> Node</span>
          <span class="int-pill"><span class="dot ok"></span> Python</span>
          <span class="int-pill"><span class="dot ok"></span> Sidekiq</span>
          <span class="int-pill"><span class="dot ok"></span> GitHub Actions</span>
          <span class="int-pill"><span class="dot ok"></span> Laravel package</span>
          <span class="int-pill"><span class="dot ok"></span> REST API</span>
          <span class="int-pill"><span class="dot ok"></span> MCP</span>
          <span class="int-pill"><span class="dot ok"></span> Webhook alerts</span>
        </div>
      </div>

    </div>

    <!-- FAQ -->
    <div class="mt-20">
      <h2 class="text-2xl font-bold text-white mb-8 text-center">Frequently asked questions</h2>
      <div class="space-y-4">

        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
          <h3 class="text-white font-semibold mb-2">Does Crontinel work without Laravel?</h3>
          <p class="text-gray-400 text-sm">Yes. Outcome monitoring uses one HTTP receipt. curl, Node, Python, Sidekiq, and GitHub Actions are first-class. Horizon and queue freshness are optional Laravel package features. Absence of a Horizon snapshot outside Laravel is normal, not an incident.</p>
        </div>

        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
          <h3 class="text-white font-semibold mb-2">How does Crontinel monitor Horizon internals?</h3>
          <p class="text-gray-400 text-sm">Crontinel reads Horizon's Redis keys directly, the same data source the Horizon dashboard uses. This means it sees actual supervisor states, actual pause status, and actual failed-jobs-per-minute rates, not just whether an HTTP health endpoint returned 200. This approach catches scenarios where Horizon reports "running" at the top level while an individual supervisor handling a critical queue has silently crashed.</p>
        </div>

        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
          <h3 class="text-white font-semibold mb-2">What queue drivers does Crontinel support?</h3>
          <p class="text-gray-400 text-sm">Crontinel supports the Redis and database queue drivers. Redis is the recommended driver for production Horizon setups, and Crontinel reads queue depths and failed counts directly from Redis. For apps using the database driver, Crontinel queries the <code class="text-gray-300 bg-gray-800 px-1 py-0.5 rounded text-xs">jobs</code> and <code class="text-gray-300 bg-gray-800 px-1 py-0.5 rounded text-xs">failed_jobs</code> tables. SQS and other drivers are not currently supported.</p>
        </div>

        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
          <h3 class="text-white font-semibold mb-2">Does cron tracking require code changes to my scheduled commands?</h3>
          <p class="text-gray-400 text-sm">No. Crontinel hooks into Laravel's built-in scheduler events (<code class="text-gray-300 bg-gray-800 px-1 py-0.5 rounded text-xs">ScheduledTaskStarting</code>, <code class="text-gray-300 bg-gray-800 px-1 py-0.5 rounded text-xs">ScheduledTaskFinished</code>, <code class="text-gray-300 bg-gray-800 px-1 py-0.5 rounded text-xs">ScheduledTaskFailed</code>) automatically after installation. Every command defined in your <code class="text-gray-300 bg-gray-800 px-1 py-0.5 rounded text-xs">schedule()</code> method is tracked with its exit code and duration. No wrapping, no per-command changes needed.</p>
        </div>

        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
          <h3 class="text-white font-semibold mb-2">How are alerts deduplicated?</h3>
          <p class="text-gray-400 text-sm">Crontinel applies a 5-minute cooldown per alert condition. If a queue depth stays above its threshold, you receive one alert, not one per polling cycle. The alert resolves automatically when the condition clears, at which point you receive a recovery notification. This prevents alert fatigue during extended incidents while still giving you clear start and end signals.</p>
        </div>

        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
          <h3 class="text-white font-semibold mb-2">Is the OSS package free forever?</h3>
          <p class="text-gray-400 text-sm">Yes. The core Crontinel package is MIT licensed and will remain free forever. You can self-host the full monitoring dashboard, configure Slack or email alerts, and track unlimited cron runs and queue depths with no subscription required. The paid SaaS tier adds multi-app dashboards, longer history retention, and team access for engineering organizations that want managed infrastructure.</p>
        </div>

      </div>
    </div>

    <HttpReceiptCta heading="Advertise the receipt in your job" class="mt-20" />

    <!-- CTA -->
    <div class="text-center mt-12">
      <a href="https://app.crontinel.com/register" class="inline-block bg-green-500 hover:bg-green-400 text-black font-semibold px-8 py-3 rounded-lg transition-colors text-base">
        Start free, no credit card
      </a>
    </div>
  </main>

  <Footer />

<script type="application/ld+json" slot="head">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Does Crontinel work without Laravel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Outcome monitoring uses one HTTP receipt. curl, Node, Python, Sidekiq, and GitHub Actions are first-class. Horizon and queue freshness are optional Laravel package features."
      }
    },
    {
      "@type": "Question",
      "name": "How does Crontinel monitor Horizon internals?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Crontinel reads Horizon's Redis keys directly, the same data source the Horizon dashboard uses. This means it sees actual supervisor states, actual pause status, and actual failed-jobs-per-minute rates, not just whether an HTTP health endpoint returned 200."
      }
    },
    {
      "@type": "Question",
      "name": "What queue drivers does Crontinel support?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Crontinel supports the Redis and database queue drivers. Redis is the recommended driver for production Horizon setups. For apps using the database driver, Crontinel queries the jobs and failed_jobs tables."
      }
    },
    {
      "@type": "Question",
      "name": "Does cron tracking require code changes to my scheduled commands?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Crontinel hooks into Laravel's built-in scheduler events (ScheduledTaskStarting, ScheduledTaskFinished, ScheduledTaskFailed) automatically after installation. Every command defined in your schedule() method is tracked with its exit code and duration. No wrapping or per-command changes needed."
      }
    },
    {
      "@type": "Question",
      "name": "How are alerts deduplicated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Crontinel applies a 5-minute cooldown per alert condition. If a queue depth stays above its threshold, you receive one alert, not one per polling cycle. The alert resolves automatically when the condition clears."
      }
    },
    {
      "@type": "Question",
      "name": "Is the OSS package free forever?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The core Crontinel package is MIT licensed and will remain free forever. You can self-host the full monitoring dashboard, configure Slack or email alerts, and track unlimited cron runs and queue depths with no subscription required."
      }
    }
  ]
}
</script>
</Base>
