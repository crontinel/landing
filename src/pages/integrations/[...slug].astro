---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import HttpReceiptCta from '../../components/HttpReceiptCta.astro';
import { buildRelatedLinks } from '../../lib/related-content';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const pages = await getCollection('integrations');
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);

const [integrations, blogPosts, useCases, vsPages] = await Promise.all([
  getCollection('integrations'),
  getCollection('blog'),
  getCollection('use-cases'),
  getCollection('vs'),
]);

const relatedItems = buildRelatedLinks(page, 'integrations', [
  { collection: 'integrations', entries: integrations, weight: 4 },
  { collection: 'blog', entries: blogPosts, weight: 2 },
  { collection: 'use-cases', entries: useCases, weight: 2 },
  { collection: 'vs', entries: vsPages, weight: 1 },
]);

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://crontinel.com" },
    { "@type": "ListItem", "position": 2, "name": "Integrations", "item": "https://crontinel.com/integrations/" },
    { "@type": "ListItem", "position": 3, "name": page.data.title, "item": `https://crontinel.com/integrations/${page.id}/` }
  ]
};
---

<Base
  title={`${page.data.title} - Crontinel`}
  description={page.data.description ?? page.data.title}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumb)} />
  <Nav />

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-16" id="main-content">
    <a href="/integrations/" class="text-sm text-gray-400 hover:text-gray-300 mb-8 inline-block">← All integrations</a>
    <h1 class="text-3xl font-bold text-white mb-8">{page.data.title}</h1>
    <article class="prose prose-invert prose-gray text-sm leading-relaxed max-w-none
      prose-headings:text-white prose-headings:font-semibold
      prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-4
      prose-h3:text-base prose-h3:mt-6 prose-h3:mb-2
      prose-p:text-gray-400 prose-p:mb-4
      prose-li:text-gray-400
      prose-strong:text-white
      prose-code:text-green-400 prose-code:bg-green-500/10 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:font-normal
      prose-pre:bg-gray-950 prose-pre:border prose-pre:border-gray-800 prose-pre:rounded-xl
      prose-table:text-sm prose-th:text-gray-400 prose-th:font-medium prose-td:text-gray-300
      prose-a:text-green-400 prose-a:no-underline hover:prose-a:text-green-300">
      <Content />
    </article>

    <RelatedContent heading="See also" items={relatedItems} />

    <HttpReceiptCta />
  </main>

  <Footer />
</Base>
