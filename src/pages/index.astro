<section class="section" id="sec-install">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Receipt</span>
      <h2 class="display h2">Post this body.</h2>
      <p class="body">Same JSON from five runtimes. <code class="mono">CRONTINEL_INGEST_KEY</code> is the app ingest key. It is not an assistant key.</p>
    </div>
    <div class="reveal" id="receipt" data-home-receipt>
      <div class="flex flex-wrap gap-1 mb-3" role="tablist" aria-label="Runtime examples">
        {Object.entries({ curl: 'curl', node: 'Node', python: 'Python', sidekiq: 'Sidekiq', gha: 'GitHub Actions' }).map(([id, label], i) => (
          <button
            type="button"
            class:list={['home-runtime-tab mono text-xs px-3 py-1.5 rounded border transition-colors', i === 1 ? 'border-green-500/50 text-green-400' : 'border-white/10 text-slate-400']}
            data-home-runtime={id}
            aria-selected={i === 1 ? 'true' : 'false'}
          >{label}</button>
        ))}
      </div>
      <div class="install-cmd">
        <span data-home-receipt-label>Node fetch. curl posts this same JSON.</span>
        <button class="copy" data-copy={receiptSnippet} data-home-copy>COPY</button>
      </div>
      <pre class="viz-log" data-home-receipt-pre>{receiptSnippet}</pre>
    </div>
  </div>
</section>
<script define:vars={{ receiptSnippets }}>
  const root = document.querySelector('[data-home-receipt]');
  if (root) {
    const pre = root.querySelector('[data-home-receipt-pre]');
    const copy = root.querySelector('[data-home-copy]');
    const label = root.querySelector('[data-home-receipt-label]');
    const labels = {
      curl: 'curl. Same JSON as every other tab.',
      node: 'Node fetch. curl posts this same JSON.',
      python: 'Python helper script. Same ingest body.',
      sidekiq: 'Sidekiq / Ruby Net::HTTP. Rescue on failure.',
      gha: 'GitHub Actions step after the job.',
    };
    root.querySelectorAll('[data-home-runtime]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-home-runtime');
        const snip = receiptSnippets[id];
        if (!snip || !pre) return;
        pre.textContent = snip;
        if (copy) copy.setAttribute('data-copy', snip);
        if (label) label.textContent = labels[id] || '';
        root.querySelectorAll('[data-home-runtime]').forEach((b) => {
          const on = b === btn;
          b.setAttribute('aria-selected', on ? 'true' : 'false');
          b.classList.toggle('border-green-500/50', on);
          b.classList.toggle('text-green-400', on);
          b.classList.toggle('border-white/10', !on);
          b.classList.toggle('text-slate-400', !on);
        });
      });
    });
  }
</script>

