---
const runtimes = [
  {
    id: 'curl',
    label: 'curl',
    snippet: `curl -X POST "$CRONTINEL_API_URL/api/v1/ingest/cron" \\
  -H "Authorization: Bearer $CRONTINEL_INGEST_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{"command":"nightly-import","status":"completed","exit_code":0,"outcomes":{"metrics":{"processed_records":0}}}'`,
  },
  {
    id: 'node',
    label: 'Node',
    snippet: `await fetch("https://app.crontinel.com/api/v1/ingest/cron", {
  method: "POST",
  headers: {
    Authorization: \`Bearer \${process.env.CRONTINEL_INGEST_KEY}\`,
    "Content-Type": "application/json",
  },
  body: JSON.stringify({
    request_key: "run-1",
    command: "nightly-import",
    status: "completed",
    exit_code: 0,
    started_at: "2026-10-06T02:00:00Z",
    finished_at: "2026-10-06T02:00:04Z",
    outcomes: { metrics: { processed_records: 0 } },
  }),
});`,
  },
  {
    id: 'python',
    label: 'Python',
    snippet: `python3 outcome_checkin.py \\
  --command nightly-import \\
  --request-key run-1 \\
  --exit-code 0 \\
  --started-at 2026-10-06T02:00:00Z \\
  --finished-at 2026-10-06T02:00:04Z \\
  --records 0 \\
  --url https://app.crontinel.com \\
  --api-key "$CRONTINEL_INGEST_KEY"`,
  },
  {
    id: 'sidekiq',
    label: 'Sidekiq',
    snippet: `uri = URI("https://app.crontinel.com/api/v1/ingest/cron")
req = Net::HTTP::Post.new(uri)
req["Authorization"] = "Bearer #{ENV.fetch("CRONTINEL_INGEST_KEY")}"
req["Content-Type"] = "application/json"
req.body = {
  request_key: "sidekiq-#{jid}-#{started}",
  command: "nightly-import",
  status: "completed",
  exit_code: 0,
  started_at: started,
  finished_at: Time.now.utc.iso8601,
  outcomes: { metrics: { processed_records: records } },
}.to_json
Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(req) } rescue nil`,
  },
  {
    id: 'gha',
    label: 'GitHub Actions',
    snippet: `- name: Report outcome
  env:
    CRONTINEL_INGEST_KEY: \${{ secrets.CRONTINEL_INGEST_KEY }}
  run: |
    curl -sS -X POST "https://app.crontinel.com/api/v1/ingest/cron" \\
      -H "Authorization: Bearer $CRONTINEL_INGEST_KEY" \\
      -H "Content-Type: application/json" \\
      -d "{\\"request_key\\":\\"gha-run\\",\\"command\\":\\"nightly-import\\",\\"status\\":\\"completed\\",\\"exit_code\\":0,\\"started_at\\":\\"$(date -u +%FT%TZ)\\",\\"outcomes\\":{\\"metrics\\":{\\"processed_records\\":0}}}" \\
      || true`,
  },
];

interface Props {
  heading?: string;
  class?: string;
}

const {
  heading = 'Start with one HTTP receipt',
  class: className = 'mt-16',
} = Astro.props;

const initial = runtimes[0];
---

<div class:list={[className, 'bg-gray-900 border border-green-500/20 rounded-xl p-8 text-center']} data-receipt-cta>
  <h2 class="text-xl font-bold text-white mb-2">{heading}</h2>
  <p class="text-gray-400 mb-4">
    Five common runtimes post the same outcome body: curl, Node, Python, Sidekiq, and GitHub Actions.
    Laravel apps can add the Composer package for schedule, queue, and Horizon.
  </p>
  <div class="flex flex-wrap gap-1 justify-center mb-4 bg-gray-950/80 p-1 rounded-lg max-w-2xl mx-auto" role="tablist" aria-label="Runtime receipt examples">
    {runtimes.map((r, i) => (
      <button
        type="button"
        role="tab"
        data-runtime-tab={r.id}
        aria-selected={i === 0 ? 'true' : 'false'}
        class:list={[
          'runtime-tab flex-1 min-w-[4.5rem] py-2 px-2 rounded-md text-xs font-medium transition-colors',
          i === 0 ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white',
        ]}
      >
        {r.label}
      </button>
    ))}
  </div>
  <div class="relative max-w-xl mx-auto mb-6" data-receipt={initial.snippet}>
    <pre class="bg-gray-950 rounded-lg p-4 pr-14 font-mono text-xs sm:text-sm text-green-400 text-left overflow-x-auto whitespace-pre-wrap m-0" data-receipt-pre>{initial.snippet}</pre>
    <button
      type="button"
      role="button"
      aria-label="Copy to clipboard"
      class="absolute top-2 right-2 text-xs text-gray-400 hover:text-gray-300 bg-gray-800 hover:bg-gray-700 px-2 py-1 rounded transition-colors"
      data-copy-receipt
    >Copy</button>
  </div>
  <div class="flex flex-col sm:flex-row gap-3 justify-center">
    <a
      href="https://app.crontinel.com/register"
      class="inline-block bg-green-500 hover:bg-green-400 text-black font-semibold px-6 py-2.5 rounded transition-colors"
    >
      Create an app
    </a>
    <a
      href="https://docs.crontinel.com/check-in/recipes/"
      class="inline-block border border-gray-600 hover:border-green-500/50 text-white font-semibold px-6 py-2.5 rounded transition-colors"
    >
      Check-in recipes
    </a>
  </div>
</div>

<script define:vars={{ runtimes }}>
  document.querySelectorAll('[data-receipt-cta]').forEach((root) => {
    const pre = root.querySelector('[data-receipt-pre]');
    const wrap = root.querySelector('[data-receipt]');
    const copyBtn = root.querySelector('[data-copy-receipt]');
    const byId = Object.fromEntries(runtimes.map((r) => [r.id, r.snippet]));

    root.querySelectorAll('[data-runtime-tab]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-runtime-tab');
        const snippet = byId[id];
        if (!snippet || !pre || !wrap) return;
        pre.textContent = snippet;
        wrap.setAttribute('data-receipt', snippet);
        root.querySelectorAll('[data-runtime-tab]').forEach((b) => {
          const on = b === btn;
          b.setAttribute('aria-selected', on ? 'true' : 'false');
          b.classList.toggle('bg-gray-800', on);
          b.classList.toggle('text-white', on);
          b.classList.toggle('text-gray-400', !on);
        });
        if (copyBtn) copyBtn.textContent = 'Copy';
      });
    });

    copyBtn?.addEventListener('click', () => {
      const text = wrap?.getAttribute('data-receipt') || '';
      navigator.clipboard.writeText(text).then(() => {
        copyBtn.textContent = 'Copied!';
        setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500);
      });
    });
  });
</script>
