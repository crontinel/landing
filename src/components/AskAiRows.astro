const agents = [
  { href: '/llms.txt', label: 'llms.txt' },
  { href: '/agent/', label: 'Agent guide' },
  { href: 'https://docs.crontinel.com/agent/guide/', label: 'MCP docs', external: true },
];
---

<div class="ask-ai">
  <div class="ask-ai-col">
    <p class="ask-ai-title">Ask AI about Crontinel</p>
    <p class="ask-ai-prompt"><span aria-hidden="true">&gt;</span> {prompt}<i class="ask-ai-caret" aria-hidden="true"></i></p>
    <div class="ask-ai-pills">
      <span class="ask-ai-send">Send it to</span>
      {ai.map(a => (
        <a href={a.href} target="_blank" rel="noopener" class="ask-ai-pill" style={`--brand:${a.color.startsWith('url') ? '#8ab4f8' : a.color}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill={a.color} aria-hidden="true"><path d={a.icon} /></svg>
          {a.label}
        </a>
      ))}
    </div>
  </div>
  <div class="ask-ai-col ask-ai-agents">
    <p class="ask-ai-title">For agents</p>
    <p class="ask-ai-links">
      {agents.map((a, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <a href={a.href} {...(a.external ? { target: '_blank', rel: 'noopener' } : {})}>{a.label}</a>
        </>
      ))}
    </p>
  </div>
  <svg width="0" height="0" aria-hidden="true" style="position:absolute">
    <defs>
      <linearGradient id="ask-ai-gemini" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#4285f4" /><stop offset="0.55" stop-color="#9b72cb" /><stop offset="1" stop-color="#d96570" />
      </linearGradient>
    </defs>
  </svg>
</div>

<style>
  .ask-ai { display: grid; grid-template-columns: 1.7fr 1fr; border-top: 1px dashed var(--border, #1c1c1c); border-bottom: 1px dashed var(--border, #1c1c1c); margin: 8px 0 28px; }
  .ask-ai-col { padding: 26px 0; }
  .ask-ai-agents { padding-left: 32px; border-left: 1px dashed var(--border, #1c1c1c); }
  .ask-ai-title { margin: 0 0 14px; font-family: var(--font-mono, monospace); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-3, #737373); }
  .ask-ai-prompt { margin: 0 0 18px; padding: 12px 14px; max-width: 560px; border: 1px solid var(--border, #262626); border-radius: 10px; background: var(--bg-card, #0a0a0a); font-family: var(--font-mono, monospace); font-size: 13px; line-height: 1.5; color: var(--text-2, #d4d4d4); }
  .ask-ai-prompt span { color: #4ade80; }
  .ask-ai-caret { display: inline-block; width: 7px; height: 14px; margin-left: 3px; vertical-align: -2px; background: #4ade80; animation: ask-ai-blink 1.1s steps(1) infinite; }
  .ask-ai-pills { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .ask-ai-send { margin-right: 4px; font-size: 13px; color: var(--text-3, #737373); }
  .ask-ai-pill { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 16px; border: 1px solid var(--border, #262626); border-radius: 999px; background: var(--bg-card, #0a0a0a); color: var(--text, #e5e5e5); font-size: 14px; transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s; }
  .ask-ai-pill:hover { border-color: var(--brand); box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 22%, transparent); transform: translateY(-1px); }
  .ask-ai-links { margin: 0; font-size: 14px; color: var(--text-3, #737373); }
  .ask-ai-links a { color: var(--text-2, #a3a3a3); transition: color 0.15s; }
  .ask-ai-links a:hover { color: var(--text, #fff); }
  @keyframes ask-ai-blink { 50% { opacity: 0; } }
  @media (max-width: 720px) {
    .ask-ai { grid-template-columns: 1fr; }
    .ask-ai-agents { padding-left: 0; border-left: 0; border-top: 1px dashed var(--border, #1c1c1c); }
  }
  @media (prefers-reduced-motion: reduce) { .ask-ai-caret { animation: none; } }
</style>
