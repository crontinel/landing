---
interface Props {
  name: string;
  logo: string;
  tags: string[];
}
const { name, logo, tags } = Astro.props;
---

<div class="product-visual" aria-hidden="true">
  {name === 'CloudPloy' ? (
    <>
      <div class="mini-terminal">
        <div class="terminal-header"><span class="window-dots"><i /><i /><i /></span><span>your next deployment</span><span>›_</span></div>
        <div class="terminal-body">
          <span class="terminal-muted">~/my-next-big-thing</span>
          <p><span class="prompt">❯</span> deploy with cloudploy<span class="cursor"> ▌</span></p>
          <span class="terminal-line"><b>✓</b> Connected to your cloud</span>
          <span class="terminal-line"><b>✓</b> Built for your workflow</span>
          <div class="deploy-pill"><i />From prompt to production <span>↗</span></div>
        </div>
      </div>
      <span class="visual-caption">Your cloud. Your workflow.</span>
    </>
  ) : name === 'SkaleAgents' ? (
    <>
      <svg class="agent-connectors" viewBox="0 0 540 270" preserveAspectRatio="none"><path d="M135 104 264 157 418 96M264 157l150 48" /></svg>
      <span class="agent-hub"><img src={`/products/${logo}`} alt="" width="44" height="44" loading="lazy" /></span>
      <span class="agent-chip agent-editor"><span>⌘</span> Your editor</span>
      <span class="agent-chip agent-security"><i />Security review</span>
      <span class="agent-chip agent-reliability"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 12h5l3-8 4 16 3-8h5" /></svg>Reliability</span>
      <span class="visual-caption">Specialist agents. Shared context.</span>
    </>
  ) : name === 'Toolblip' ? (
    <>
      <div class="tool-tiles">
        {['{ }', 'Aa', '#', '↔', '</>', '◐'].map((symbol, i) => <span class={`tool-tile tile-${i}`}>{symbol}</span>)}
      </div>
      <span class="visual-caption">Open a tab. Get it done.</span>
    </>
  ) : (
    <>
      <div class="symbol-orbit" />
      <div class="symbol-group">
        <span class="large-symbol"><img src={`/products/${logo}`} alt="" width="66" height="66" loading="lazy" /></span>
        <span class="symbol-label">{name === 'AmazingPlugins' ? 'Made for WooCommerce' : name === 'Appnary' ? 'Made for Shopify' : 'Notes from the work'}</span>
      </div>
      <span class="visual-caption">{tags.join(' / ')}</span>
    </>
  )}
</div>

<style>
  .product-visual { height: 280px; position: relative; display: flex; align-items: center; justify-content: center; padding-top: 20px; color: #b6c1cf; }
  .visual-caption { position: absolute; bottom: 18px; left: 12px; right: 12px; text-align: center; font-size: 10px; letter-spacing: .06em; }
  .mini-terminal { width: 72%; background: #10151c; border: 1px solid #344153; border-radius: 7px; box-shadow: 0 12px 20px #00000033; transform: rotate(-3deg); }
  .terminal-header { display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; font-size: 8px; border-bottom: 1px solid #2a3543; color: #a9b5c6; }
  .window-dots { display: flex; gap: 4px; }
  .window-dots i { width: 5px; height: 5px; border-radius: 50%; background: #e9baac; }
  .window-dots i:nth-child(2) { background: #e6d29d; }
  .window-dots i:nth-child(3) { background: #b5d5b7; }
  .terminal-body { padding: 14px 16px; font-family: var(--font-mono); font-size: 10px; }
  .terminal-muted { color: #9aa8bb; font-size: 9px; }
  .terminal-body p { margin: 7px 0 10px; white-space: nowrap; }
  .prompt { color: #93c5fd; }
  .cursor { color: #8ca7ce; }
  .terminal-line { display: flex; gap: 6px; margin-top: 5px; font-size: 9px; }
  .terminal-line b { color: #86efac; }
  .deploy-pill { display: flex; align-items: center; gap: 6px; margin-top: 12px; padding: 7px; border-radius: 3px; background: #142d21; color: #9dd5af; font-size: 8px; }
  .deploy-pill i, .agent-security i { width: 4px; height: 4px; border-radius: 50%; background: #86efac; }
  .deploy-pill > span { margin-left: auto; }
  .agent-connectors { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: #6c5a8e; stroke-width: 1.5; stroke-dasharray: 3 3; }
  .agent-hub { position: absolute; left: 43%; top: 42%; width: 78px; height: 78px; border: 1px solid #4a3b63; border-radius: 20px; background: #10151c; display: grid; place-items: center; transform: rotate(-7deg); }
  .agent-chip { position: absolute; display: flex; align-items: center; gap: 9px; padding: 12px 14px; border: 1px solid #493d5d; border-radius: 6px; background: #241d31; color: #d5c4ed; font-size: 11px; box-shadow: 0 5px 15px #00000026; }
  .agent-editor { top: 29%; left: 10%; transform: rotate(-5deg); }
  .agent-editor > span { font-size: 17px; }
  .agent-security { top: 29%; right: 7%; transform: rotate(4deg); }
  .agent-reliability { top: 66%; right: 10%; transform: rotate(-3deg); }
  .tool-tiles { display: grid; grid-template-columns: repeat(3, 63px); gap: 10px; transform: rotate(-8deg); }
  .tool-tile { display: grid; place-items: center; width: 63px; height: 59px; border: 1px solid #395649; border-radius: 9px; background: #1a3025; color: #a2d5b5; font-family: var(--font-mono); font-size: 23px; }
  .tile-1, .tile-5 { background: #332a1b; border-color: #635236; color: #e0bf86; }
  .tile-2 { background: #2d2339; border-color: #564164; color: #d8b5e6; }
  .tile-3 { background: #1b2c3a; border-color: #365167; color: #a0cbe9; }
  .symbol-orbit { position: absolute; width: 202px; height: 202px; border: 1px solid #b6c1cf1a; border-radius: 50%; }
  .symbol-orbit::after { content: ''; position: absolute; inset: 23px; border: 1px dashed #b6c1cf26; border-radius: 50%; }
  .symbol-group { display: flex; flex-direction: column; align-items: center; gap: 13px; position: relative; }
  .large-symbol { display: grid; place-items: center; width: 100px; height: 100px; background: #252a2f; border-radius: 25px; transform: rotate(-8deg); box-shadow: 0 7px 17px #00000033; }
  img { object-fit: contain; }
  .symbol-label { padding: 5px 8px; border-radius: 4px; background: #252a2f; font-size: 10px; }
  @media (max-width: 767px) {
    .product-visual { height: 250px; }
    .mini-terminal { width: 82%; }
    .agent-hub { width: 64px; height: 64px; left: 40%; top: 43%; }
    .agent-chip { font-size: 9px; padding: 10px; gap: 6px; }
    .agent-editor { left: 7%; }
    .agent-security { right: 5%; }
    .agent-reliability { right: 8%; }
    .visual-caption { font-size: 8px; }
    .terminal-body { font-size: 9px; padding: 11px 12px; }
    .terminal-line, .terminal-muted { font-size: 8px; }
  }
</style>
