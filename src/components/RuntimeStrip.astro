---
interface Props {
  class?: string;
  compact?: boolean;
}

const { class: className = '', compact = false } = Astro.props;

const runtimes = [
  { label: 'curl', href: 'https://docs.crontinel.com/check-in/recipes/#system-cron' },
  { label: 'Node', href: 'https://docs.crontinel.com/check-in/recipes/#node' },
  { label: 'Python', href: 'https://docs.crontinel.com/check-in/recipes/#python' },
  { label: 'Sidekiq', href: 'https://docs.crontinel.com/check-in/recipes/#sidekiq--ruby' },
  { label: 'GitHub Actions', href: 'https://docs.crontinel.com/check-in/recipes/#github-actions' },
];
---

<div class:list={[className, 'runtime-strip']}>
  {!compact && (
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3 text-center">
      Check in from five common runtimes
    </p>
  )}
  <ul class="flex flex-wrap gap-2 justify-center list-none m-0 p-0">
    {runtimes.map((r) => (
      <li>
        <a
          href={r.href}
          class="inline-block font-mono text-xs sm:text-sm text-green-400 bg-green-500/10 border border-green-500/20 hover:border-green-400/50 px-3 py-1.5 rounded transition-colors"
        >
          {r.label}
        </a>
      </li>
    ))}
  </ul>
  {!compact && (
    <p class="text-center text-xs text-gray-500 mt-3">
      Same HTTP receipt. Laravel is the deep package for schedule, queue, and Horizon.
      <a href="https://docs.crontinel.com/check-in/recipes/" class="text-green-400 underline ml-1">All recipes</a>
    </p>
  )}
</div>
