<style>
  .directory-slider { display: block; margin-bottom: 2.5rem; }
  .directory-slider-viewport { overflow-x: auto; scrollbar-width: thin; }
  .directory-slider-track { display: flex; width: max-content; animation: directory-scroll 180s linear infinite; }
  .directory-slider-group { display: flex; flex: none; align-items: center; gap: 1.5rem; padding: 4px 1.5rem 4px 0; }
  .directory-slider-group > a {
    display: inline-flex !important;
    flex: none;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 48px;
    white-space: nowrap;
  }
  .directory-slider-group > a > img:only-child {
    display: block;
    height: 48px !important;
    width: auto !important;
    max-width: none !important;
    object-fit: contain;
  }
  .directory-slider-group > a:has(> span) { padding: 4px 12px !important; gap: 8px !important; }
  .directory-slider-group > a > svg { width: 32px; height: 32px; flex: none; }
  .directory-slider-group > a > span > span:nth-child(2) { font-size: 15px !important; }
  .directory-slider-group > a > span > span:nth-child(3) { display: none; }
  .directory-slider-group > a:not(:has(img, svg)) { padding: 0 16px; border: 1px solid #333; border-radius: 8px; color: #d4d4d4; font-size: 14px; }
  .directory-slider:hover .directory-slider-track { animation-play-state: paused; }
  .directory-slider-viewport:focus-within .directory-slider-track { animation: none; }
  .directory-slider-viewport:focus-within .directory-slider-group[aria-hidden] { display: none; }
  a:focus-visible, .directory-slider-viewport:focus-visible { outline: 2px solid #4ade80; outline-offset: 2px; }
  @keyframes directory-scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .directory-slider-track { animation: none; }
    .directory-slider-group[aria-hidden] { display: none; }
  }
</style>

<script>
  class DirectorySlider extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll('.directory-slider-group[aria-hidden] a').forEach(link => link.setAttribute('tabindex', '-1'));
    }
  }
  if (!customElements.get('directory-slider')) customElements.define('directory-slider', DirectorySlider);
</script>
