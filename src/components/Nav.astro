---
const navItems = [
  { label: 'Product', items: [
    { href: '/features/', label: 'Features' },
    { href: '/integrations/', label: 'Integrations' },
    { href: '/agent/', label: 'Agent' },
  ] },
  { label: 'Solutions', items: [
    { href: '/use-cases/', label: 'Use cases' },
    { href: '/vs/', label: 'Compare' },
  ] },
  { href: '/pricing/', label: 'Pricing' },
  { label: 'Resources', items: [
    { href: 'https://docs.crontinel.com/introduction/', label: 'Docs', external: true },
    { href: 'https://docs.crontinel.com/check-in/recipes/', label: 'Recipes', external: true },
    { href: '/blog/', label: 'Blog' },
    { href: '/about/', label: 'About' },
  ] },
];
const ext = (l) => (l.external ? { target: '_blank', rel: 'noopener' } : {});
---

<header id="site-nav" class="sticky top-0 z-40 transition-all duration-300"
        style="background: rgba(0,0,0,0.8); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid #1c1c1c;">
  <nav aria-label="Main navigation" class="max-w-5xl mx-auto px-4 sm:px-6 flex items-center justify-between h-14">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 font-semibold text-white text-sm">
      <img src="/logo.png" alt="Crontinel" width="22" height="22" class="shrink-0" />
      <span>Crontinel</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-6">
      {navItems.map((item) => item.items ? (
        <div class="nav-dd relative">
          <button type="button" class="nav-link flex items-center gap-1" aria-haspopup="true">
            {item.label}
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
          </button>
          <div class="nav-panel absolute left-0 top-full pt-3">
            <div class="rounded-lg py-1.5 min-w-44" style="background:#0a0a0a; border:1px solid #1c1c1c;">
              {item.items.map((l) => (
                <a href={l.href} class="nav-link block text-sm px-4 py-2" {...ext(l)}>{l.label}</a>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <a href={item.href} class="nav-link text-sm" {...ext(item)}>{item.label}</a>
      ))}
    </div>

    <!-- Desktop CTA -->
    <div class="hidden md:flex items-center gap-3">
      <a href="https://app.crontinel.com/login"
         class="text-sm font-medium px-4 py-1.5 rounded-lg transition-all duration-200"
         style="background:#22c55e; color:#000;"
         onmouseover="this.style.background='#16a34a'"
         onmouseout="this.style.background='#22c55e'">
        Get started
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 transition-colors"
      style="color:#a3a3a3;"
      aria-label="Toggle mobile menu"
      aria-expanded="false"
      onmouseover="this.style.color='#fff'"
      onmouseout="this.style.color='#a3a3a3'"
    >
      <svg id="hamburger-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg id="close-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t px-4 py-4 space-y-1"
    style="background:#000; border-color:#1c1c1c;"
  >
    {navItems.map((item) => item.items ? (
      <>
      <p class="text-xs uppercase tracking-wider pt-3 pb-1" style="color:#525252;">{item.label}</p>
      {item.items.map((l) => (
        <a href={l.href} class="nav-link block text-sm py-2.5 pl-3" {...ext(l)}>{l.label}</a>
      ))}
      </>
    ) : (
      <a href={item.href} class="nav-link block text-sm py-2.5" {...ext(item)}>{item.label}</a>
    ))}
    <div class="flex items-center gap-3 pt-3" style="border-top: 1px solid #1c1c1c;">
      <a href="https://app.crontinel.com/login"
         class="flex-1 text-center text-sm font-medium py-2 rounded-lg transition-all duration-200"
         style="background:#22c55e; color:#000;">
        Get started
      </a>
    </div>
  </div>
</header>

<style>
  .nav-link { color: #a3a3a3; font-size: 0.875rem; transition: color 0.15s; }
  .nav-link:hover, .nav-link:focus-visible { color: #fff; }
  /* the landing page's global `svg { display: block }` would otherwise beat Tailwind's .hidden */
  #hamburger-icon.hidden, #close-icon.hidden { display: none; }
  .nav-panel { display: none; }
  .nav-dd:hover .nav-panel, .nav-dd:focus-within .nav-panel { display: block; }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    hamburger?.classList.toggle('hidden', !isOpen);
    close?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
