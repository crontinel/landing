{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "crontinel-landing",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	"ratelimits": [
		{
			"name": "AI_CRAWL_LIMITER",
			"namespace_id": "841001",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "SEARCH_CRAWL_LIMITER",
			"namespace_id": "841002",
			"simple": { "limit": 120, "period": 60 }
		},
		{
			"name": "UNKNOWN_CRAWL_LIMITER",
			"namespace_id": "841003",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	"vars": {
		"PUBLIC_GA_MEASUREMENT_ID": "G-KJDPL4R7LZ",
		"PUBLIC_POSTHOG_API_KEY": "",
		"PUBLIC_POSTHOG_ENABLED": "true"
	}
}
